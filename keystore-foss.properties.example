# Copy to keystore-foss.properties (gitignored) and fill in your FOSS release-key values.
# Create the keystore once with:
#   keytool -genkey -v -keystore .local/keystore/orgl-foss.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias orgl-foss
#
# Paths are relative to the project root.

storeFile=.local/keystore/orgl-foss.jks
storePassword=CHANGE_ME
keyAlias=orgl-foss
keyPassword=CHANGE_ME
