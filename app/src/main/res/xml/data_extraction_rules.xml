<?xml version="1.0" encoding="utf-8"?>
<!--
  Device-local prefs live in datastore/orgl_device.preferences_pb (see SettingsRepository).
  Include full app files, then exclude the device-only DataStore file from cloud backup / transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="datastore/orgl_device.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <exclude domain="file" path="datastore/orgl_device.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
