# Copy to keystore.properties (gitignored) and fill in your upload-key values.
# Create the keystore once with:
#   keytool -genkey -v -keystore .local/keystore/orgl-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias orgl-upload
#
# Paths are relative to the project root.

storeFile=.local/keystore/orgl-upload.jks
storePassword=CHANGE_ME
keyAlias=orgl-upload
keyPassword=CHANGE_ME
